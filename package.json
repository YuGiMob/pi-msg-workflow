{
  "name": "pi-msg-workflow",
  "version": "3.0.0",
  "type": "module",
  "description": "Pi extension: predefined message and command stores plus a configurable improvement workflow",
  "main": "index.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuGiMob/pi-msg-workflow.git"
  },
  "author": "YuGiMob",
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "extension",
    "workflow",
    "messages",
    "commands",
    "review"
  ],
  "license": "MIT",
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE",
    "messages.json",
    "commands.json",
    "workflow.json"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@earendil-works/pi-tui": "^0.84.0",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.9"
  }
}
